pipeline {
    agent any

    tools {
        maven 'Maven-3.9.11'
        jdk 'JDK-17'
    }

    environment {
        SONARQUBE = 'SonarQube'
        DOCKER_IMAGE = "yassinebourich/employee-management:latest"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build & Test') {
            steps {
                sh 'mvn clean package'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv("${SONARQUBE}") {
                sh 'mvn clean verify sonar:sonar'}
            }
        }

        stage('Build Docker Image') {
            steps {
                sh "docker build -t ${DOCKER_IMAGE} ."
            }
        }

        stage('Push Docker Image') {
            steps {
                // DockerHub credentials stored in Jenkins as "dockerhub-pass"
                withCredentials([string(credentialsId: 'Jenkins-Docker-Token', variable: 'TOKEN')]) {
                    sh "echo $TOKEN | docker login -u yassinebourich --password-stdin"
                    sh "docker push ${DOCKER_IMAGE}"
                }
            }
        }

        stage('Deploy to Minikube') {
            steps {
                sh "kubectl apply -f k8s/postgres-deployment.yaml"
                sh "kubectl apply -f k8s/postgres-service.yaml"
                sh "kubectl apply -f k8s/app-deployment.yaml"
                sh "kubectl apply -f k8s/app-service.yaml"
                sh "minikube addons enable ingress"
                sh "kubectl apply -f k8s/ingress.yaml"

                sh "minikube service list"

                script {
                    echo "Fetching Ingress URL..."


                    // Get host
                    def host = sh(
                        script: "kubectl get ingress employee-ingress -o jsonpath='{.spec.rules[0].host}'",
                        returnStdout: true
                    ).trim()

                    echo "--------------------------------------------"
                    echo " ACCESS YOUR APPLICATION HERE:"
                    echo "     http://${host}/Employee-Management/"
                    echo "--------------------------------------------"
                }
            }
        }

        stage('Deploy Monitoring') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'grafana-id', usernameVariable: 'GRAFANA_USER', passwordVariable: 'GRAFANA_PASS')]) {
                bat """
                set KUBECONFIG=C:\\Users\\Master\\.kube\\config

                echo === Create monitoring namespace ===
                kubectl create namespace monitoring --dry-run=client -o yaml | kubectl apply -f -

                echo === Add Helm repo ===
                C:\\Helm\\helm.exe repo add prometheus-community https://prometheus-community.github.io/helm-charts
                C:\\Helm\\helm.exe repo update

                echo === Install Prometheus + Grafana with custom credentials ===
                C:\\Helm\\helm.exe upgrade --install prometheus-stack prometheus-community/kube-prometheus-stack ^
                  --namespace monitoring ^
                  --wait --timeout=600s ^
                  --set grafana.adminUser=%GRAFANA_USER% ^
                  --set grafana.adminPassword=%GRAFANA_PASS%

                echo === Apply ServiceMonitor for employee-management ===
                kubectl apply -f k8s/servicemonitor-employee.yaml

                echo === Fetch Minikube IP ===
                for /f "tokens=*" %%i in ('minikube ip') do set MINIKUBE_IP=%%i

                echo === Port forwarding ===
                kubectl -n monitoring port-forward svc/prometheus-stack-grafana 3000:80

                echo === Grafana Access Info ===
                echo URL: http://%%MINIKUBE_IP%%:3000
                """
                }
            }
        }


        stage('Archive Artifacts') {
            steps {
                archiveArtifacts artifacts: 'target/*.war', fingerprint: true
                junit 'target/surefire-reports/*.xml'
            }
        }
    }

    post {
        success {
            echo "Pipline success."
        }
        failure {
            echo "FAILURE."
        }
        always {
            script {
                try {
                    echo "Ensuring Docker logout from ${DOCKER_REGISTRY}"
                    bat "docker logout ${DOCKER_REGISTRY}"
                } catch (Exception e) {
                    echo "Docker logout failed or not needed: ${e.getMessage()}"
                }
            }
        }
    }
}