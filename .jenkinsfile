pipeline {
    agent any

    tools {
        maven 'Maven-3.9.11'
        jdk 'JDK-17'
    }

    environment {
        SONARQUBE = 'SonarQube'
        DOCKER_IMAGE = "yassinebourich/employee-management:latest"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build & Test') {
            steps {
                sh 'mvn clean package'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv("${SONARQUBE}") {
                sh 'mvn clean verify sonar:sonar'}
            }
        }

        stage('Build Docker Image') {
            steps {
                sh "docker build -t ${DOCKER_IMAGE} ."
            }
        }

        stage('Push Docker Image') {
            steps {
                // DockerHub credentials stored in Jenkins as "dockerhub-pass"
                withCredentials([string(credentialsId: 'Jenkins-Docker-Token', variable: 'TOKEN')]) {
                    sh "echo $TOKEN | docker login -u yassinebourich --password-stdin"
                    sh "docker push ${DOCKER_IMAGE}"
                }
            }
        }

        stage('Deploy to Minikube') {
            steps {
                sh "kubectl apply -f k8s/postgres-deployment.yaml"
                sh "kubectl apply -f k8s/postgres-service.yaml"
                sh "kubectl apply -f k8s/app-deployment.yaml"
                sh "kubectl apply -f k8s/app-service.yaml"
                sh "kubectl apply -f k8s/ingress.yaml"
            }
            post {
                script {
                    echo "Fetching Kubernetes service URL..."

                    // Show all services for debugging
                    sh 'kubectl get svc -n default'

                    // Get NodePort of the app
                    def nodePort = sh(
                        script: "kubectl get svc employee-management-service -o jsonpath='{.spec.ports[0].nodePort}'",
                        returnStdout: true
                    ).trim()

                    // Get minikube IP
                    def miniIP = sh(
                        script: "minikube ip",
                        returnStdout: true
                    ).trim()

                    echo " APPLICATION URL:"
                    echo " http://${miniIP}:${nodePort}/Employee-Management/"
                }
            }
        }


        stage('Archive Artifacts') {
            steps {
                archiveArtifacts artifacts: 'target/*.war', fingerprint: true
                junit 'target/surefire-reports/*.xml'
            }
        }
    }

    post {
        success {
            echo "Pipline success."
        }
        failure {
            echo "FAILURE."
        }
    }
}